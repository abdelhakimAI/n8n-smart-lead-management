    {
      "parameters": {
        "jsCode": "/**\n * =====================================================\n * Production Calendar Scheduler\n * Smart Lead Management\n * =====================================================\n */\n\nconst CONFIG = {\n    HIGH_PRIORITY_SCORE: 80,\n\n    BUSINESS_START_HOUR: 9,\n    BUSINESS_START_MINUTE: 0,\n\n    BUSINESS_END_HOUR: 17,\n    BUSINESS_END_MINUTE: 30,\n\n    MEETING_DURATION_MINUTES: 30,\n\n    HIGH_PRIORITY_DELAY_MINUTES: 30,\n};\n\n//-------------------------------------------\n// Input\n//-------------------------------------------\n\nconst score = Number($('Parsing the scoring').item.json.score);\n\n//-------------------------------------------\n// Current time\n//-------------------------------------------\n\nconst now = new Date();\n\n//-------------------------------------------\n// Helpers\n//-------------------------------------------\n\nfunction isWeekend(date) {\n    const day = date.getDay();\n    return day === 0 || day === 6;\n}\n\nfunction isBusinessHours(date) {\n\n    if (isWeekend(date)) return false;\n\n    const minutes =\n        date.getHours() * 60 +\n        date.getMinutes();\n\n    const start =\n        CONFIG.BUSINESS_START_HOUR * 60 +\n        CONFIG.BUSINESS_START_MINUTE;\n\n    const end =\n        CONFIG.BUSINESS_END_HOUR * 60 +\n        CONFIG.BUSINESS_END_MINUTE;\n\n    return minutes >= start && minutes < end;\n}\n\nfunction nextBusinessDay9AM(date) {\n\n    const d = new Date(date);\n\n    do {\n        d.setDate(d.getDate() + 1);\n    }\n    while (isWeekend(d));\n\n    d.setHours(\n        CONFIG.BUSINESS_START_HOUR,\n        CONFIG.BUSINESS_START_MINUTE,\n        0,\n        0\n    );\n\n    return d;\n}\n\nfunction addMinutes(date, minutes) {\n    return new Date(date.getTime() + minutes * 60000);\n}\n\n//-------------------------------------------\n// Scheduling Logic\n//-------------------------------------------\n\nlet start;\nlet end;\nlet reason;\n\nif (score >= CONFIG.HIGH_PRIORITY_SCORE) {\n\n    if (isBusinessHours(now)) {\n\n        const candidateStart =\n            addMinutes(\n                now,\n                CONFIG.HIGH_PRIORITY_DELAY_MINUTES\n            );\n\n        const businessClose = new Date(now);\n\n        businessClose.setHours(\n            CONFIG.BUSINESS_END_HOUR,\n            CONFIG.BUSINESS_END_MINUTE,\n            0,\n            0\n        );\n\n        const candidateEnd =\n            addMinutes(\n                candidateStart,\n                CONFIG.MEETING_DURATION_MINUTES\n            );\n\n        if (candidateEnd <= businessClose) {\n\n            start = candidateStart;\n\n            end = candidateEnd;\n\n            reason =\n                \"High priority during business hours\";\n\n        } else {\n\n            start = nextBusinessDay9AM(now);\n\n            end = addMinutes(\n                start,\n                CONFIG.MEETING_DURATION_MINUTES\n            );\n\n            reason =\n                \"Business closing soon\";\n        }\n\n    } else {\n\n        start = nextBusinessDay9AM(now);\n\n        end = addMinutes(\n            start,\n            CONFIG.MEETING_DURATION_MINUTES\n        );\n\n        reason =\n            \"Outside business hours\";\n    }\n\n} else {\n\n    start = nextBusinessDay9AM(now);\n\n    end = addMinutes(\n        start,\n        CONFIG.MEETING_DURATION_MINUTES\n    );\n\n    reason =\n        \"Normal priority\";\n}\n\n//-------------------------------------------\n// Output\n//-------------------------------------------\n\nreturn [{\n    json: {\n\n        score,\n\n        priority:\n            score >= CONFIG.HIGH_PRIORITY_SCORE\n                ? \"High\"\n                : \"Normal\",\n\n        calendarStart:\n            start.toISOString(),\n\n        calendarEnd:\n            end.toISOString(),\n\n        schedulingReason:\n            reason,\n\n        generatedAt:\n            now.toISOString()\n    }\n}];"
      },
